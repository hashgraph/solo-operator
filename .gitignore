._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local environment
.env
.env.local
.envrc

# Build output
dist/

# Kubernetes
kubeconfig
*.kubeconfig

# Test artifacts
testbin/
setup-envtest

# Controller-runtime test binaries
/bin/k8s/

# Generated files (uncomment if you want to ignore)
# config/crd/bases/

