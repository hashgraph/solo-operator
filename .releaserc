{
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    "@semantic-release/git",
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "build/kubernetes/kubernetes.yml", "label": "Kubernetes Operator Manifest", "name": "deployment.yml" },
          { "path": "build/kubernetes/kubernetes.json", "label": "Kubernetes Operator Manifest", "name": "deployment.json" },
          { "path": "build/kubernetes/capsules.solo.hedera.com-v1.yml", "label": "Kubernetes Capsule CRD", "name": "capsules.solo.hedera.com-v1.yml" },
          { "path": "build/kubernetes/orbits.solo.hedera.com-v1.yml", "label": "Kubernetes Orbit CRD", "name": "orbits.solo.hedera.com-v1.yml" },
          { "path": "build/helm/solo-operator-${nextRelease.version}.tgz", "label": "Helm Chart", "name": "solo-operator-${nextRelease.version}.tgz" }
        ]
      }
    ]
  ],
  "verifyRelease": [
    [
      "@semantic-release/exec",
      { "cmd": "./gradlew versionAsSpecified -PnewVersion=${nextRelease.version}" }
    ],
    [
      "@semantic-release/exec",
      { "cmd": "./gradlew clean assemble --no-build-cache" }
    ],
    [
      "@semantic-release/exec",
      { "cmd": "cd ./build/helm && helm package ." }
    ]
  ],
  "prepare": [
    [
      "@semantic-release/exec",
      { "cmd": "./gradlew githubVersionSummary" }
    ],
    [
      "@semantic-release/exec",
      { "cmd": "docker buildx build --platform linux/amd64,linux/arm64 -f src/main/docker/Dockerfile.jvm --tag artifacts.swirldslabs.io/solo-operator-docker-release/solo-operator:${nextRelease.version} --push ." }
    ],
    [
      "@semantic-release/exec",
      { "cmd": "helm push ./build/helm/solo-operator-${nextRelease.version}.tgz oci://artifacts.swirldslabs.io/solo-operator-helm-release" }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "gradle.properties"
        ]
      }
    ],
    [
      "@semantic-release/exec",
      { "cmd": "git branch release/${nextRelease.version.split('.')[0]}.${nextRelease.version.split('.')[1]}" }
    ],
    [
      "@semantic-release/exec",
      { "cmd": "git push -u origin release/${nextRelease.version.split('.')[0]}.${nextRelease.version.split('.')[1]}" }
    ]
  ],
  "branches":[
    {
      "name": "main"
    },
    {
      "name": "release/([0-9]+).([0-9]+)",
      "channel": "${name.replace(/release\\//g, '').split('.')[0]}.${name.replace(/release\\//g, '').split('.')[1]}.x",
      "range": "${name.replace(/release\\//g, '').split('.')[0]}.${name.replace(/release\\//g, '').split('.')[1]}.x"
    },
    {
      "name": "alpha/*",
      "prerelease": "alpha",
      "channel": "alpha"
    },
    {
      "name": "ci/*",
      "prerelease": "alpha",
      "channel": "alpha"
    },
    {
      "name": "beta/*",
      "prerelease": "beta",
      "channel": "beta"
    },
    {
      "name": "rc/*",
      "prerelease": "rc",
      "channel": "rc"
    }
  ]
}
