# SPDX-License-Identifier: Apache-2.0

# Dockerfile for the beacon HAPI control-plane CLI. Published as a separate
# image, released in lockstep with the operator + UC (see design.md §6, §13),
# so it can run as an in-cluster Kubernetes Job that reaches consensus-node gRPC
# endpoints over Service DNS. Mirrors the operator/UC Dockerfiles: a selector
# stage picks the pre-compiled arch binary, then the final stage runs it.
# beacon reads its config.yaml (-c) and keys/ from mounted volumes (ConfigMap +
# Secret) and submits HAPI transactions.

# Selector stage: pick the pre-compiled binary for the target architecture.
# TARGETARCH is set by docker buildx to the target platform (amd64/arm64),
# which matches our binary suffix — unlike uname -m which reflects the builder.
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8 AS selector

ARG TARGETARCH

COPY bin/beacon-linux-* /tmp/

RUN cd /tmp && \
    sha256sum -c beacon-linux-${TARGETARCH}.sha256 && \
    cp beacon-linux-${TARGETARCH} /beacon && \
    chmod +x /beacon

# Final stage.
#
# We use debian:bookworm-slim (not distroless) so the image ships a shell for
# `kubectl exec` debugging when beacon runs as an in-cluster Job/sidecar, and we
# create the hedera user (2000:2000) to match the consensus-node and UC images
# so any shared volume ownership lines up. The runtime user is still overridable
# per deployment via the pod/container securityContext, which takes precedence
# over this image USER.
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

# Match the consensus-node and UC images: hedera group and user, both 2000.
RUN groupadd --gid 2000 hedera && \
    useradd --uid 2000 --gid 2000 --create-home --shell /bin/bash hedera

WORKDIR /

COPY --from=selector /beacon .

USER 2000:2000

ENTRYPOINT ["/beacon"]
